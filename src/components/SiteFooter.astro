---
interface Props {
  navItems: readonly { href: string; label: string }[];
  currentPath: string;
}

const { navItems, currentPath } = Astro.props;
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="footer-grid">
    <nav aria-label="Footer navigation">
      <h2>Explore</h2>
      <ul class="footer-links">
        {navItems.map(({ href, label }) => (
          <li><a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Footer contact links">
      <h2>Connect</h2>
      <ul class="footer-links">
        <li><a href="mailto:lorenztazan@gmail.com">Email Lorenz</a></li>
        <li><a href="https://github.com/AIKUSAN" rel="me">GitHub @AIKUSAN</a></li>
      </ul>
    </nav>
    <nav aria-label="Footer information">
      <h2>Information</h2>
      <ul class="footer-links">
        <li><a href="/contact#hiring-faq">For hiring teams</a></li>
        <li><a href="/contact#contact-privacy">Contact privacy</a></li>
      </ul>
    </nav>
  </div>
  <div class="footer-document">
    <span>© {year} Lorenz Tazan</span>
    <span>DOC. NO. LT-IOM-2026-01</span>
    <span>CLASSIFICATION: PUBLIC</span>
    <span>REV. A</span>
  </div>
</footer>
