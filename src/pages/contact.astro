---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Mail, Send } from '@lucide/astro';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import { resolveTurnstileSiteKey } from '@/lib/turnstile.mjs';

// Hosted builds validate this in npm's prebuild step, before prerendering.
const turnstileSiteKey = resolveTurnstileSiteKey(PUBLIC_TURNSTILE_SITE_KEY, false);
---

<BaseLayout
  title="Contact — Lorenz Tazan"
  description="Contact Lorenz Tazan about IT support, systems, network, infrastructure, or platform opportunities."
  currentPath="/contact"
>
  <div class="page-shell">
    <header class="page-heading">
      <div>
        <h1>Start a conversation</h1>
      </div>
      <p>Tell me about the role, your team, and the environment you need help supporting. Send a message below or email me directly.</p>
    </header>
    <a class="contact-email inline-icon-link" href="mailto:lorenztazan@gmail.com"><Mail aria-hidden="true" size={20} stroke-width={1.5} />lorenztazan@gmail.com</a>

    <div class="contact-grid">
      <form class="contact-form" action="/api/contact" method="post" data-contact-form>
        <div class="form-field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="80" placeholder="Your name" /></div>
        <div class="form-field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@company.com" /></div>
        <div class="form-field"><label for="focus">Role focus <span>(optional)</span></label><select id="focus" name="focus" aria-describedby="focus-help"><option value="">Not specified</option><option value="support">IT Support / Service Desk</option><option value="systems">Systems / Network</option><option value="platform">Cloud / Platform</option></select><p id="focus-help" class="form-help">Based on your selected role. You can change it here.</p></div>
        <div class="form-field"><label for="message">Message</label><textarea id="message" name="message" required minlength="20" maxlength="4000" aria-describedby="message-help" placeholder="Tell me about the role, team, and what you need help operating."></textarea><p id="message-help" class="form-help">20–4,000 characters. Please do not include sensitive credentials or personal records.</p></div>
        <div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
        <div class="turnstile-slot" data-turnstile-sitekey={turnstileSiteKey} role="group" aria-label="Spam protection verification"></div>
        <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        <a class="form-recovery inline-icon-link" href="mailto:lorenztazan@gmail.com" data-form-recovery hidden><Mail aria-hidden="true" size={20} stroke-width={1.5} />Email Lorenz instead</a>
        <button class="button-manual primary" type="submit">Send message <Send aria-hidden="true" size={18} stroke-width={1.5} /></button>
        <noscript><p class="form-help">JavaScript is required for spam verification. You can email <a href="mailto:lorenztazan@gmail.com">lorenztazan@gmail.com</a> directly.</p></noscript>
      </form>

      <aside class="contact-panel">
        <h2>Direct channels</h2>
        <p>For résumé follow-up or a time-sensitive opportunity, email is the most direct route.</p>
        <div class="direct-links">
          <a href="mailto:lorenztazan@gmail.com"><span>Email</span><span>lorenztazan@gmail.com</span></a>
          <a href="https://github.com/AIKUSAN"><span>GitHub</span><span>@AIKUSAN</span></a>
          <a href="/resume/lorenz-tazan-systems-cloud.pdf" data-resume-link><span>Résumé</span><span>Open PDF</span></a>
        </div>
      </aside>
    </div>
  </div>
  <script>
    import { resolveFocus } from '@/lib/role-focus';
    import { contactFailureMessage } from '@/lib/contact-feedback';
    const slot = document.querySelector<HTMLElement>('.turnstile-slot');
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const status = document.querySelector<HTMLElement>('[data-form-status]');
    const recovery = document.querySelector<HTMLElement>('[data-form-recovery]');
    const showStatus = (state: 'loading' | 'success' | 'error', message: string) => {
      if (status) {
        status.dataset.state = state;
        status.textContent = message;
      }
      if (recovery) recovery.hidden = state !== 'error';
    };
    const roleSelect = document.querySelector('select');
    const selectedFocus = resolveFocus(new URLSearchParams(location.search).get('focus'));
    if (roleSelect) {
      for (const option of roleSelect.options) option.defaultSelected = option.value === selectedFocus;
      roleSelect.value = selectedFocus;
    }

    const loadTurnstile = () => {
      if (!slot || document.querySelector('script[data-turnstile-script]')) return;
      if (!slot.dataset.turnstileSitekey) {
        showStatus('error', 'Verification could not load. Your message is still here. Please reload when ready or email me directly.');
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.defer = true;
      script.addEventListener('error', () => {
        showStatus('error', 'Verification could not load. Your message is still here. Please reload when ready or email me directly.');
      });
      script.dataset.turnstileScript = 'true';
      script.addEventListener('load', () => {
        const sitekey = slot.dataset.turnstileSitekey;
        if (!sitekey) return;
        window.turnstile?.render(slot, {
          sitekey,
          action: 'portfolio_contact',
          theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'
        });
      });
      document.head.appendChild(script);
    };

    if (slot) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          loadTurnstile();
          observer.disconnect();
        }
      }, { rootMargin: '300px' });
      observer.observe(slot);
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submit?.setAttribute('disabled', '');
      form.setAttribute('aria-busy', 'true');
      showStatus('loading', 'Sending your message…');

      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!response.ok) {
          showStatus('error', contactFailureMessage(response.status));
          window.turnstile?.reset(slot);
          return;
        }
        form.reset();
        window.turnstile?.reset(slot);
        showStatus('success', 'Message sent. Thank you—I will reply by email.');
      } catch {
        showStatus('error', contactFailureMessage());
        window.turnstile?.reset(slot);
      } finally {
        form.removeAttribute('aria-busy');
        submit?.removeAttribute('disabled');
      }
    });
  </script>
</BaseLayout>
